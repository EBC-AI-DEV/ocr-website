# Client-side Direct OCR API URL (visible in browser Network tab)
NEXT_PUBLIC_OCR_API_URL=https://ocr.ebc.edu.kh/api/ocr_api

# Server-side OCR API Configuration
OCR_API_URL=https://ocr.ebc.edu.kh/api/ocr_api
OCR_API_USERNAME=demo
OCR_API_SECRET_KEY=demo

# Optional: Set to 'production' or 'development'
NODE_ENV=development

# Optional: For bundle analysis
# ANALYZE=true
